# Server-only secrets. Set in Vercel, never commit real values.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Oli model. GPT-5.6 Luna is the cost-sensitive default.
OPENAI_OLI_MODEL=gpt-5.6-luna

# Public AdSense configuration. Publisher/client ID is safe to expose by design.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4805370280965046
NEXT_PUBLIC_ADSENSE_FREE_FEED_SLOT=
NEXT_PUBLIC_ADSENSE_FREE_BANNER_SLOT=

# Add only after native listings exist. Oli hides rating links when blank.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Existing admin/reporting variables as applicable.
ADMIN_EMAILS=
MOTHERSHIP_REPORT_TOKEN=
